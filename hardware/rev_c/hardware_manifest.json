  "requirements": {
    "passive_rf": {
      "sub_ghz": "855-925 MHz channelized RSSI/activity observation with E07-900M10S; no 433 MHz operation",
      "two_point_four_ghz": "2400-2500 MHz RSSI/activity sweep with Ebyte E28-2G4M12SX (SX1281) plus ESP32 Wi-Fi/BLE receive functions; not protocol identity",
      "five_point_eight_ghz": "RX5808 2012-format 12-pad module, eight hardware-selected channels (5645-5945 MHz) and analog RSSI observation",
      "remote_id": "experimental BLE/Wi-Fi receive software; no standards-conformance claim"
    },
    "ui": "Adafruit PID 326 SSD1306 OLED on a keyed removable 4-pin JST-SH (STEMMA QT) harness, status LED, user button, buzzer and optional vibration motor",
    "storage": "removable microSD in exact Molex 104031-0811 socket on the shared SPI bus with independent chip select",
    "position": "u-blox SAM-M10Q-00B GNSS module, UART NMEA and optional TIMEPULSE",
    "networking": "ESP32 Wi-Fi dashboard and ESP-NOW only; no canonical LoRa radio",
    "power": "USB-C or protected 1S 2500 mAh LiPo input, BQ24074 power-path charging, switched TPS61232 5 V system rail and AP63203 3.3 V rail",
    "programming": "ESP32-S3 native USB, manual BOOT/RESET, labelled UART0/test pads",
    "enclosure": "indoor portable two-part printed enclosure with internal protected battery bay; not sealed and not IP rated",
    "assembly": "four-layer assembled PCB with E28, E07 and RX5808 receive modules plus lid-mounted OLED harness"
  },
  "excluded": [
    "LoRa radio",
    "TinyML model inference",
    "direction finding",
    "unprotected or thermistor-dependent battery packs",
    "active countermeasures or jamming outputs"
  ],
