* text=auto eol=lf
*.{cmd,[cC][mM][dD]} text eol=crlf
*.{bat,[bB][aA][tT]} text eol=crlf

# KiCad and FreeCAD STEP continuation records contain tool-significant trailing
# spaces; they are generated CAD syntax rather than handwritten source.
*.step -whitespace
*.stl -whitespace

# Generated contracts and reproducible CAD reports are reviewed outputs, not
# authored product implementation for language statistics.
src/generated/** linguist-generated=true
hardware/rev_c/manufacturing/gerbers/** linguist-generated=true
hardware/rev_c/validation/** linguist-generated=true
docs/** linguist-documentation=true
